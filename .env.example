# Paper trading keys from https://app.alpaca.markets/
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_PAPER=true

# Kill switch. false = no new positions; existing positions still monitored.
TRADING_ENABLED=true

# Optional Claude key — unused until the AI supervisor phase.
ANTHROPIC_API_KEY=

# Conservative first-cycle defaults
MAX_RISK_PER_TRADE=0.01
MAX_PORTFOLIO_EXPOSURE=0.20
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.08
MAX_POSITIONS=3
MAX_UNDERLYING_CONCENTRATION=0.15
MAX_BID_ASK_SPREAD=0.08
MIN_OPTION_VOLUME=10
MIN_OPEN_INTEREST=50
MIN_DTE=3
MAX_DTE=45
LOOP_INTERVAL_SECONDS=60

UNDERLYINGS=SPY,QQQ,IWM
DATABASE_PATH=data/agent.db
LOG_LEVEL=INFO
